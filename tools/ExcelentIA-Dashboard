<script>
  // ── Reloj en vivo ──
  function updateClock() {
    const now = new Date();
    const h = String(now.getHours()).padStart(2,'0');
    const m = String(now.getMinutes()).padStart(2,'0');
    const s = String(now.getSeconds()).padStart(2,'0');
    document.getElementById('live-time').textContent = `${h}:${m}:${s}`;

    const hour = now.getHours();
    let greeting = hour < 12 ? 'Buenos días ☀️' : hour < 19 ? 'Buenas tardes 🌤️' : 'Buenas noches 🌙';
    document.getElementById('live-greeting').textContent = greeting;
  }
  updateClock();
  setInterval(updateClock, 1000);

  // ── Cambio de pestañas ──
  function switchTab(tab) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));

    const tabs = ['agenda','correo','tareas','gastos','noticias','proyectos'];
    const idx = tabs.indexOf(tab);
    document.querySelectorAll('.tab')[idx].classList.add('active');
    document.getElementById('panel-' + tab).classList.add('active');
  }

  // ── Toggle tareas ──
  function toggleTask(el) {
    const isDone = el.classList.toggle('done');
    const title = el.nextElementSibling.querySelector('.task-title');
    if (isDone) {
      el.textContent = '✓';
      title.classList.add('done-text');
    } else {
      el.textContent = '';
      title.classList.remove('done-text');
    }
  }
</script>

