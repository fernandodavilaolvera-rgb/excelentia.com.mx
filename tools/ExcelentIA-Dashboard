<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ExcelentIA Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Special+Elite&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f5f6f8;
    --white: #ffffff;
    --border: #dde1e9;
    --header-from: #0d1b3e;
    --header-to: #1e5096;
    --accent: #4a9fd4;
    --accent-dark: #1a3a6b;
    --hover: #e8f0fb;
    --card-head: #dce8f7;
    --alert-bg: #f0f6ff;
    --alert-border: #c8d9f0;
    --note-bg: #eef4fc;
    --text: #1a2035;
    --text-sec: #4a5068;
    --text-muted: #8a90a0;
    --green: #22c55e;
    --orange: #f59e0b;
    --red: #ef4444;
    --purple: #8b5cf6;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Manrope', sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 17px;
    min-height: 100vh;
  }

  /* ── HEADER ── */
  .header {
    background: linear-gradient(135deg, var(--header-from) 0%, #1a3a6b 60%, var(--header-to) 100%);
    border-bottom: 3px solid var(--accent);
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-area {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-text {
    font-family: 'Special Elite', serif;
    font-size: 22px;
    color: #fff;
    letter-spacing: 0.5px;
  }

  .logo-sub {
    font-size: 11px;
    color: rgba(255,255,255,0.5);
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .divider-v {
    width: 1px;
    height: 32px;
    background: rgba(255,255,255,0.2);
  }

  .client-badge {
    background: rgba(74,159,212,0.2);
    border: 1px solid rgba(74,159,212,0.4);
    border-radius: 20px;
    padding: 4px 14px;
    color: #a8d4f0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(34,197,94,0.15);
    border: 1px solid rgba(34,197,94,0.3);
    border-radius: 20px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 700;
    color: #4ade80;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    animation: blink 1.5s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .header-time {
    color: rgba(255,255,255,0.75);
    font-size: 15px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .header-greeting {
    color: rgba(255,255,255,0.55);
    font-size: 13px;
  }

  /* ── TABS ── */
  .tabs-bar {
    background: var(--white);
    border-bottom: 1px solid var(--border);
    padding: 0 28px;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs-bar::-webkit-scrollbar { display: none; }

  .tab {
    padding: 14px 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 7px;
    user-select: none;
  }

  .tab:hover {
    color: var(--accent-dark);
    background: var(--hover);
    border-radius: 8px 8px 0 0;
  }

  .tab.active {
    color: var(--accent-dark);
    border-bottom-color: var(--accent);
    font-weight: 700;
  }

  .tab-count {
    background: var(--accent);
    color: #fff;
    border-radius: 10px;
    padding: 1px 7px;
    font-size: 11px;
    font-weight: 700;
  }

  /* ── MAIN CONTENT ── */
  .content {
    padding: 28px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .panel { display: none; }
  .panel.active { display: block; }

  /* ── SUMMARY BAR ── */
  .summary-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .summary-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    transition: background 0.2s;
  }

  .summary-card:hover { background: var(--hover); }

  .summary-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
  }

  .summary-icon.blue { background: #dce8f7; }
  .summary-icon.green { background: #dcfce7; }
  .summary-icon.orange { background: #fef3c7; }
  .summary-icon.purple { background: #ede9fe; }

  .summary-num {
    font-size: 28px;
    font-weight: 800;
    color: var(--text);
    line-height: 1;
  }

  .summary-label {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
    margin-top: 3px;
  }

  /* ── SECTION HEADER ── */
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .section-title {
    font-family: 'Special Elite', serif;
    font-size: 19px;
    color: var(--accent-dark);
  }

  .refresh-btn {
    background: var(--alert-bg);
    border: 1px solid var(--alert-border);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-dark);
    cursor: pointer;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .refresh-btn:hover { background: var(--hover); }

  /* ── GRID LAYOUTS ── */
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* ── CARD ── */
  .card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }

  .card-head {
    background: var(--card-head);
    padding: 13px 18px;
    font-weight: 700;
    font-size: 14px;
    color: var(--accent-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .card-body { padding: 18px; }

  /* ── AGENDA ── */
  .event-item {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
  }

  .event-item:last-child { border-bottom: none; padding-bottom: 0; }
  .event-item:first-child { padding-top: 0; }

  .event-time {
    min-width: 68px;
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .event-bar {
    width: 3px;
    border-radius: 2px;
    flex-shrink: 0;
    min-height: 40px;
  }

  .event-info { flex: 1; }

  .event-title {
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
  }

  .event-meta {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .event-badge {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 9px;
    border-radius: 10px;
    white-space: nowrap;
  }

  .badge-now { background: #dcfce7; color: #15803d; }
  .badge-next { background: #fef3c7; color: #b45309; }
  .badge-later { background: var(--alert-bg); color: var(--accent-dark); }

  /* ── CORREO ── */
  .mail-item {
    display: flex;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
    cursor: pointer;
    transition: background 0.15s;
    border-radius: 8px;
    padding-left: 8px;
  }

  .mail-item:hover { background: var(--hover); }
  .mail-item:last-child { border-bottom: none; }

  .mail-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 15px;
    color: #fff;
    flex-shrink: 0;
  }

  .mail-body { flex: 1; min-width: 0; }

  .mail-from {
    font-weight: 700;
    font-size: 14px;
    color: var(--text);
  }

  .mail-subject {
    font-size: 14px;
    color: var(--text-sec);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mail-preview {
    font-size: 13px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mail-meta {
    text-align: right;
    flex-shrink: 0;
  }

  .mail-time {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 600;
  }

  .mail-unread-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    margin: 6px auto 0;
  }

  .unread .mail-from,
  .unread .mail-subject { color: var(--text); font-weight: 700; }

  /* ── TAREAS ── */
  .task-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
  }

  .task-item:last-child { border-bottom: none; }

  .task-check {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 2px solid var(--border);
    flex-shrink: 0;
    cursor: pointer;
    margin-top: 1px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }

  .task-check:hover { border-color: var(--accent); background: var(--hover); }
  .task-check.done { background: var(--green); border-color: var(--green); color: #fff; }

  .task-content { flex: 1; }

  .task-title {
    font-weight: 600;
    font-size: 15px;
    color: var(--text);
  }

  .task-title.done-text {
    text-decoration: line-through;
    color: var(--text-muted);
  }

  .task-tags {
    display: flex;
    gap: 6px;
    margin-top: 5px;
    flex-wrap: wrap;
  }

  .task-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 8px;
  }

  .tag-alta { background: #fee2e2; color: #991b1b; }
  .tag-media { background: #fef3c7; color: #92400e; }
  .tag-baja { background: #dcfce7; color: #166534; }
  .tag-proyecto { background: var(--alert-bg); color: var(--accent-dark); }

  /* ── GASTOS ── */
  .gasto-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
  }

  .gasto-item:last-child { border-bottom: none; }

  .gasto-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .gasto-info { flex: 1; }

  .gasto-name {
    font-weight: 600;
    font-size: 15px;
    color: var(--text);
  }

  .gasto-cat {
    font-size: 13px;
    color: var(--text-muted);
  }

  .gasto-amount {
    font-weight: 800;
    font-size: 16px;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .gasto-amount.egreso { color: var(--red); }
  .gasto-amount.ingreso { color: var(--green); }

  /* Barra de progreso presupuesto */
  .budget-bar-wrap {
    margin-top: 6px;
  }

  .budget-label {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 5px;
  }

  .budget-bar {
    height: 8px;
    background: var(--bg);
    border-radius: 4px;
    overflow: hidden;
  }

  .budget-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.6s ease;
  }

  /* ── NOTICIAS ── */
  .noticia-item {
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
  }

  .noticia-item:last-child { border-bottom: none; }
  .noticia-item:hover .noticia-title { color: var(--accent); }

  .noticia-source {
    font-size: 11px;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 5px;
  }

  .noticia-title {
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
    line-height: 1.35;
    transition: color 0.2s;
  }

  .noticia-desc {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
    line-height: 1.4;
  }

  .noticia-meta {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 6px;
  }

  /* ── PROYECTOS ── */
  .proyecto-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }

  .proyecto-card:hover {
    box-shadow: 0 4px 20px rgba(26,58,107,0.1);
  }

  .proyecto-head {
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border);
  }

  .proyecto-emoji {
    font-size: 28px;
  }

  .proyecto-name {
    font-weight: 800;
    font-size: 16px;
    color: var(--text);
  }

  .proyecto-client {
    font-size: 13px;
    color: var(--text-muted);
  }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-produccion { background: var(--green); }
  .status-desarrollo { background: var(--orange); }
  .status-pendiente { background: var(--text-muted); }

  .proyecto-body { padding: 16px 18px; }

  .progress-wrap { margin-bottom: 12px; }

  .progress-label {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .progress-bar {
    height: 8px;
    background: var(--bg);
    border-radius: 4px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--accent-dark), var(--accent));
    transition: width 0.8s ease;
  }

  .proyecto-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .ptag {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 8px;
    background: var(--alert-bg);
    color: var(--accent-dark);
    border: 1px solid var(--alert-border);
  }

  /* ── CHART (mini barras CSS) ── */
  .mini-chart {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 70px;
    padding: 0 4px;
  }

  .bar-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    height: 100%;
    justify-content: flex-end;
  }

  .bar {
    width: 100%;
    border-radius: 4px 4px 0 0;
    background: linear-gradient(180deg, var(--accent) 0%, var(--accent-dark) 100%);
    transition: height 0.6s ease;
  }

  .bar-label {
    font-size: 10px;
    color: var(--text-muted);
    font-weight: 600;
  }

  /* ── NOTA FOOTER ── */
  .note-footer {
    background: var(--note-bg);
    border-left: 3px solid var(--accent-dark);
    border-radius: 0 8px 8px 0;
    padding: 10px 14px;
    font-size: 13px;
    color: var(--text-sec);
    margin-top: 16px;
  }

  /* ── ALERT ── */
  .alert-info {
    background: var(--alert-bg);
    border: 1px solid var(--alert-border);
    border-left: 4px solid var(--accent);
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 14px;
    color: var(--accent-dark);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .summary-bar { grid-template-columns: repeat(2, 1fr); }
    .grid-2 { grid-template-columns: 1fr; }
    .grid-3 { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .header { padding: 0 16px; height: auto; min-height: 60px; flex-wrap: wrap; gap: 8px; padding-top: 10px; padding-bottom: 10px; }
    .content { padding: 16px; }
    .tabs-bar { padding: 0 12px; }
    .tab { padding: 12px 14px; font-size: 13px; }
    .summary-bar { grid-template-columns: 1fr 1fr; gap: 10px; }
    .summary-num { font-size: 22px; }
    .header-right { gap: 10px; }
    .logo-text { font-size: 18px; }
  }
</style>
</head>
<body>

<!-- ══ HEADER ══ -->
<header class="header">
  <div class="header-left">
    <div class="logo-area">
      <span class="logo-text">ExcelentIA</span>
      <span class="logo-sub">Dashboard</span>
    </div>
    <div class="divider-v"></div>
    <span class="client-badge" id="client-name">Fernando Dávila</span>
  </div>
  <div class="header-right">
    <div>
      <div class="header-time" id="live-time">--:--</div>
      <div class="header-greeting" id="live-greeting">—</div>
    </div>
    <div class="live-badge">
      <span class="live-dot"></span>LIVE
    </div>
  </div>
</header>

<!-- ══ TABS ══ -->
<nav class="tabs-bar">
  <div class="tab active" onclick="switchTab('agenda')">📅 Agenda <span class="tab-count">4</span></div>
  <div class="tab" onclick="switchTab('correo')">📧 Correo <span class="tab-count">7</span></div>
  <div class="tab" onclick="switchTab('tareas')">✅ Tareas <span class="tab-count">5</span></div>
  <div class="tab" onclick="switchTab('gastos')">💸 Gastos</div>
  <div class="tab" onclick="switchTab('noticias')">📰 Noticias</div>
  <div class="tab" onclick="switchTab('proyectos')">🚀 Proyectos</div>
</nav>

<!-- ══ CONTENT ══ -->
<main class="content">

  <!-- ━━ AGENDA ━━ -->
  <div id="panel-agenda" class="panel active">

    <div class="summary-bar">
      <div class="summary-card">
        <div class="summary-icon blue">📅</div>
        <div>
          <div class="summary-num">4</div>
          <div class="summary-label">Eventos hoy</div>
        </div>
      </div>
      <div class="summary-card">
        <div class="summary-icon green">⏰</div>
        <div>
          <div class="summary-num">23 min</div>
          <div class="summary-label">Próximo evento</div>
        </div>
      </div>
      <div class="summary-card">
        <div class="summary-icon orange">📆</div>
        <div>
          <div class="summary-num">11</div>
          <div class="summary-label">Esta semana</div>
        </div>
      </div>
      <div class="summary-card">
        <div class="summary-icon purple">🕐</div>
        <div>
          <div class="summary-num">5.5 h</div>
          <div class="summary-label">En reuniones hoy</div>
        </div>
      </div>
    </div>

    <div class="grid-2">
      <!-- Hoy -->
      <div class="card">
        <div class="card-head">
          <span>📅 Hoy — Viernes 2 de mayo</span>
          <button class="refresh-btn">↻ Actualizar</button>
        </div>
        <div class="card-body">
          <div class="event-item">
            <div class="event-time">09:00</div>
            <div class="event-bar" style="background:#22c55e;"></div>
            <div class="event-info">
              <div class="event-title">Stand-up ExcelentIA</div>
              <div class="event-meta">Google Meet · 30 min · Equipo</div>
            </div>
            <span class="event-badge badge-now">En curso</span>
          </div>
          <div class="event-item">
            <div class="event-time">10:00</div>
            <div class="event-bar" style="background:#f59e0b;"></div>
